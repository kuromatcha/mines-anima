","name":"style","type":"STRING","widget":{"name":"style"},"link":null},{"label":"positive prompt","name":"positive_prompt","type":"STRING","widget":{"name":"positive_prompt"},"link":null},{"label":"negative prompt","name":"negative_prompt","type":"STRING","widget":{"name":"negative_prompt"},"link":null},{"label":"model","name":"unet_name","type":"COMBO","widget":{"name":"unet_name"},"link":null},{"label":"lora","name":"lora_name","type":"COMBO","widget":{"name":"lora_name"},"link":null},{"label":"lora strength","name":"strength_model","type":"FLOAT","widget":{"name":"strength_model"},"link":null},{"label":"megapixels","name":"megapixels","type":"FLOAT","widget":{"name":"megapixels"},"link":null},{"label":"context","name":"context","type":"FLOAT","widget":{"name":"context"},"link":null},{"label":"grow mask","name":"grow","type":"INT","widget":{"name":"grow"},"link":null},{"label":"blend edge","name":"blend","type":"INT","widget":{"name":"blend"},"link":null},{"label":"control strength","name":"strength","type":"FLOAT","widget":{"name":"strength"},"link":null},{"label":"steps","name":"steps","type":"INT","widget":{"name":"steps"},"link":null},{"label":"cfg","name":"cfg","type":"FLOAT","widget":{"name":"cfg"},"link":null},{"label":"denoise","name":"denoise","type":"FLOAT","widget":{"name":"denoise"},"link":null}],"outputs":[{"localized_name":"IMAGE","name":"IMAGE","type":"IMAGE","links":[3]},{"localized_name":"mask","label":"mask","name":"mask","type":"IMAGE","links":[55]},{"localized_name":"redrawn_part","label":"redrawn part","name":"redrawn_part","type":"IMAGE","links":[57]}],"properties":{"previewExposures":[]},"widgets_values":[false,"masterpiece, best quality, newest","","","worst quality, low quality, score_1, score_2, score_3, artist name, blurry, jpeg artifacts, lowres","anima-base-v1.0.safetensors","your_lora.safetensors",0,1,2,8,16,1,30,4,1],"widgets_values_named":{"use_mask_file":false,"quality":"masterpiece, best quality, newest","style":"","positive_prompt":"","negative_prompt":"worst quality, low quality, score_1, score_2, score_3, artist name, blurry, jpeg artifacts, lowres","unet_name":"anima-base-v1.0.safetensors","lora_name":"your_lora.safetensors","strength_model":0,"megapixels":1,"context":2,"grow":8,"blend":16,"strength":1,"steps":30,"cfg":4,"denoise":1}},{"id":30,"type":"PreviewImage","pos":[1380,-1260],"size":[840,1220],"flags":{"pinned":true},"order":4,"mode":0,"inputs":[{"localized_name":"images","name":"images","type":"IMAGE","link":55}],"outputs":[],"title":"Mask preview","properties":{"Node name for S&R":"PreviewImage"}},{"id":3,"type":"SaveImage","pos":[2240,0],"size":[840,1220],"flags":{"pinned":true},"order":3,"mode":0,"inputs":[{"localized_name":"images","name":"images","type":"IMAGE","link":3},{"localized_name":"filename_prefix","name":"filename_prefix","type":"STRING","widget":{"name":"filename_prefix"},"link":null}],"outputs":[{"localized_name":"images","name":"images","type":"IMAGE","links":null}],"title":"Result","properties":{"Node name for S&R":"SaveImage"},"widgets_values":["inpaint/anima"],"widgets_values_named":{"filename_prefix":"inpaint/anima"}},{"id":4,"type":"MarkdownNote","pos":[2240,-1260],"size":[840,1220],"flags":{"pinned":true},"order":1,"mode":0,"inputs":[],"outputs":[],"title":"Guide","properties":{},"widgets_values":["# Guide\n\n## Mask\nTwo ways, picked with **use saved mask**:\n- **Paint** (off): right-click the image → **Open in MaskEditor**, paint the area to redraw, save.\n- **Saved mask** (on): pick a mask file on *Saved mask*. White = redrawn. Channel **red** for a black-and-white mask, **alpha** for one with a transparent area. Another size is stretched to the image.\n- *Mask preview* shows the mask that was used. To keep it: right-click the preview → **Save Image**. Next time upload it on *Saved mask* and turn **use saved mask** on.\n- Cover the whole thing you replace and a little around it. What stays visible is copied back.\n- Only the painted area changes. The rest keeps its exact pixels.\n- *Redrawn part* shows the redrawn cut before it is blended back. To keep it (to reuse an expression in an image editor, say): right-click it → **Save Image**.\n\n## Prompt\n- **quality**, **style** (artist tags) and **positive prompt** are joined in that order; empty ones are skipped.\n- Describe the cut-out as it should look **after**, not the edit: the subject, then the new part. `red dress`, not `change the dress to red`.\n- Keep the artist tags and LoRA of the original picture, so the new part matches.\n- Removing something: describe what is behind it (`wall, window`), put the thing in the negative prompt.\n\n## Settings\n- **use saved mask**: off · off = painted mask, on = *Saved mask*.\n- **model**: the Anima checkpoint the picture was made with. The LLLite was trained on anima-base-v1.0; finetunes work.\n- **lora** / **lora strength**: 0 = off.\n- **megapixels**: 1 · size the cut is redrawn at. Up to 2.3 for a large area.\n- **context**: 2 · size of the cut, as a multiple of the masked area. Higher = matches the picture better. Lower = more detail. Small masks get at least 256 px.\n- **grow mask**: 8 · widens the mask (pixels).\n- **blend edge**: 16 · soft edge when the cut is put back (pixels). Raise if a seam shows.\n- **control strength**: 1 · how strongly the LLLite ties the new part to its surroundings. 0.7–0.9 = freer.\n- **steps** 30 · **cfg** 4\n- **denoise**: 1 = replace · 0.5–0.7 = keep the shapes under the mask and fix details (hands, faces).\n\n## Inside the subgraph\n- The *Previews* group shows the cut-out and its redrawn version; *Result* has the blended picture.\n- er_sde / simple · shift 3\n- Seed: random. To keep one: *Sample* → fixed.\n- Text encoder, VAE, LLLite file: the *Load …* nodes.\n\n## Routine\n1. Paint the mask, write the prompt, run.\n2. Rerun for another seed. Wrong shape: change the prompt. Seam: more blend edge or context.\n3. Next area: load the result as the image, paint again.\n4. Same area on another picture: save the mask from the preview, use it as *Saved mask*.\n\nNeeds `anima-lllite-inpainting-v2.safetensors` in `models/model_patches` and mine's pack.\n"],"widgets_values_named":{"text":"# Guide\n\n## Mask\nTwo ways, picked with **use saved mask**:\n- **Paint** (off): right-click the image → **Open in MaskEditor**, paint the area to redraw, save.\n- **Saved mask** (on): pick a mask file on *Saved mask*. White = redrawn. Channel **red** for a black-and-white mask, **alpha** for one with a transparent area. Another size is stretched to the image.\n- *Mask preview* shows the mask that was used. To keep it: right-click the preview → **Save Image**. Next time upload it on *Saved mask* and turn **use saved mask** on.\n- Cover the whole thing you replace and a little around it. What stays visible is copied back.\n- Only the painted area changes. The rest keeps its exact pixels.\n- *Redrawn part* shows the redrawn cut before it is blended back. To keep it (to reuse an expression in an image editor, say): right-click it → **Save Image**.\n\n## Prompt\n- **quality**, **style** (artist tags) and **positive prompt** are joined in that order; empty ones are skipped.\n- Describe the cut-out as it should look **after**, not the edit: the subject, then the new part. `red dress`, not `change the dress to red`.\n- Keep the artist tags and LoRA of the original picture, so the new part matches.\n- Removing something: describe what is behind it (`wall, window`), put the thing in the negative prompt.\n\n## Settings\n- **use saved mask**: off · off = painted mask, on = *Saved mask*.\n- **model**: the Anima checkpoint the picture was made with. The LLLite was trained on anima-base-v1.0; finetunes work.\n- **lora** / **lora strength**: 0 = off.\n- **megapixels**: 1 · size the cut is redrawn at. Up to 2.3 for a large area.\n- **context**: 2 · size of the cut, as a multiple of the masked area. Higher = matches the picture better. Lower = more detail. Small masks get at least 256 px.\n- **grow mask**: 8 · widens the mask (pixels).\n- **blend edge**: 16 · soft edge when the cut is put back (pixels). Raise if a seam shows.\n- **control strength**: 1 · how strongly the LLLite ties the new part to its surroundings. 0.7–0.9 = freer.\n- **steps** 30 · **cfg** 4\n- **denoise**: 1 = replace · 0.5–0.7 = keep the shapes under the mask and fix details (hands, faces).\n\n## Inside the subgraph\n- The *Previews* group shows the cut-out and its redrawn version; *Result* has the blended picture.\n- er_sde / simple · shift 3\n- Seed: random. To keep one: *Sample* → fixed.\n- Text encoder, VAE, LLLite file: the *Load …* nodes.\n\n## Routine\n1. Paint the mask, write the prompt, run.\n2. Rerun for another seed. Wrong shape: change the prompt. Seam: more blend edge or context.\n3. Next area: load the result as the image, paint again.\n4. Same area on another picture: save the mask from the preview, use it as *Saved mask*.\n\nNeeds `anima-lllite-inpainting-v2.safetensors` in `models/model_patches` and mine's pack.\n"},"color":"#432","bgcolor":"#653"},{"id":31,"type":"PreviewImage","pos":[3100,0],"size":[840,1220],"flags":{"pinned":true},"order":6,"mode":0,"inputs":[{"localized_name":"images","name":"images","type":"IMAGE","link":57}],"outputs":[],"title":"Redrawn part","properties":{"Node name for S&R":"PreviewImage"}}],"links":[[1,1,0,2,0,"IMAGE"],[2,1,1,2,1,"MASK"],[3,2,0,3,0,"IMAGE"],[54,29,0,2,2,"MASK"],[55,2,1,30,0,"IMAGE"],[57,2,2,31,0,"IMAGE"]],"groups":[],"definitions":{"subgraphs":[{"id":"5b0c1d52-6f0e-4c58-9d0e-a1e3c7b2f4a6","version":1,"state":{"lastGroupId":6,"lastNodeId":31,"lastLinkId":57,"lastRerouteId":0},"revision":0,"config":{},"name":"Mine's Anima Inpaint","inputNode":{"id":-10,"bounding":[-380,0,140.54296875,408]},"outputNode":{"id":-20,"bounding":[3660,0,128,108]},"inputs":[{"id":"3f285ba2-df91-5b49-8260-05453707ce16","name":"image","type":"IMAGE","linkIds":[29],"label":"image","pos":[-263.45703125,24]},{"id":"475fe8da-5a51-5fb9-b28c-5393